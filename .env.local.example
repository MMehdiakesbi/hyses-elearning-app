# =====================================================================
#  HYSES e-learning — variables d'environnement
#  Copie ce fichier en ".env.local" et remplis les valeurs.
#  .env.local n'est JAMAIS committe (voir .gitignore).
# =====================================================================

# --- Supabase (Dashboard > Project Settings > API) -------------------
# URL du projet, ex: https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Cle publique cote navigateur.
# Dans le dashboard recent elle s'appelle "Publishable key" (sb_publishable_...).
# Sur les projets plus anciens c'est la cle "anon". Les deux fonctionnent ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle SECRETE cote serveur uniquement (JAMAIS exposee au navigateur).
# Dashboard : "Secret key" (sb_secret_...) ou ancienne cle "service_role".
# Utilisee par le script de creation de comptes et par l'envoi d'email.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email transactionnel) — https://resend.com -------------
RESEND_API_KEY=
# Adresse expediteur. Doit appartenir a un domaine verifie dans Resend.
# Pour tester rapidement : onboarding@resend.dev
RESEND_FROM="HYSES Formation <onboarding@resend.dev>"
# Copie cachee envoyee a HYSES a chaque attestation (laisser vide pour desactiver)
RESEND_BCC=Contact.hyses@gmail.com

# --- App -------------------------------------------------------------
# URL publique du site (sert dans les emails). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
